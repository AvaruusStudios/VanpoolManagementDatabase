<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.avaruusstudios.vmdb.view.main.MainController">

  <MenuBar VBox.vgrow="NEVER">
    <Menu mnemonicParsing="false" text="File">
      <MenuItem mnemonicParsing="false" text="New" />
      <SeparatorMenuItem mnemonicParsing="false" />
      <MenuItem mnemonicParsing="false" text="Preferences…" />
      <SeparatorMenuItem mnemonicParsing="false" />
      <MenuItem mnemonicParsing="false" text="Quit" />
    </Menu>
    <Menu mnemonicParsing="false" text="Edit">
      <MenuItem mnemonicParsing="false" text="Undo" />
      <MenuItem mnemonicParsing="false" text="Redo" />
      <SeparatorMenuItem mnemonicParsing="false" />
      <MenuItem mnemonicParsing="false" text="Cut" />
      <MenuItem mnemonicParsing="false" text="Copy" />
      <MenuItem mnemonicParsing="false" text="Paste" />
      <MenuItem mnemonicParsing="false" text="Delete" />
      <SeparatorMenuItem mnemonicParsing="false" />
      <MenuItem mnemonicParsing="false" text="Select All" />
      <MenuItem mnemonicParsing="false" text="Unselect All" />
    </Menu>
    <Menu mnemonicParsing="false" text="Help">
      <MenuItem mnemonicParsing="false" text="About MyHelloApp" />
    </Menu>
  </MenuBar>

  <BorderPane VBox.vgrow="ALWAYS">

    <top>
      <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 15px;">
        <Label text="Vanpool Management Database">
          <font>
            <Font name="System Bold" size="24.0" />
          </font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <VBox>
          <Label style="-fx-font-weight: bold;" text="Current Date" />
          <Label fx:id="txtCurrentDate" />
        </VBox>
        <VBox>
          <Label style="-fx-font-weight: bold;" text="Recent Transaction Date" />
          <Label fx:id="txtRecentTransaction" />
        </VBox>
        <VBox>
          <Label style="-fx-font-weight: bold;" text="Current Balance" />
          <Label fx:id="txtBalance" />
        </VBox>
      </HBox>
    </top>

    <center>
      <SplitPane dividerPositions="0.25">
        <Accordion styleClass="left-sidebar" fx:id="mainAccordion" maxWidth="250.0" minWidth="200.0">
          <panes>
            <TitledPane fx:id="vanpoolTitledPane" animated="false" text="Vanpool">
              <VBox spacing="5.0" style="-fx-padding: 10px;">
                <Button fx:id="vanpoolDashboardButton" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-button">
                  <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                      <Label text="Dashboard" />
                      <Region HBox.hgrow="ALWAYS" />
<!--                      <Label fx:id="vanpoolDashboardCountLabel" text="0" style="-fx-font-weight: bold;" />-->
                    </HBox>
                  </graphic>
                </Button>
                <Button fx:id="vehicleDashboardButton" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-button">
                  <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                      <Label text="Vehicles" />
                      <Region HBox.hgrow="ALWAYS" />
<!--                      <Label fx:id="vanpoolDashboardCountLabel" text="0" style="-fx-font-weight: bold;" />-->
                    </HBox>
                  </graphic>
                </Button>
                <Button fx:id="routesDashboardButton" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-button">
                  <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                      <Label text="Locations" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="routesLabel" text="0" style="-fx-font-weight: bold;" />
                    </HBox>
                  </graphic>
                </Button>
                <Button fx:id="rosterDashboardButton" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-button">
                  <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                      <Label text="Participants" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="rosterLabel" text="0" style="-fx-font-weight: bold;" />
                    </HBox>
                  </graphic>
                </Button>
              </VBox>
            </TitledPane>
            <TitledPane fx:id="billingTitledPane" animated="false" text="Billing">
              <VBox spacing="5.0" style="-fx-padding: 10px;">
                <Button fx:id="billingDashboardButton" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-button">
                  <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                      <Label text="Dashboard" />
                      <Region HBox.hgrow="ALWAYS" />
<!--                      <Label fx:id="billingDashboardCountLabel" text="0" style="-fx-font-weight: bold;" />-->
                    </HBox>
                  </graphic>
                </Button>
                <Button fx:id="transactionLogDashboardButton" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-button">
                  <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                      <Label text="Transaction Log" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="transactionLogLabel" text="0" style="-fx-font-weight: bold;" />
                    </HBox>
                  </graphic>
                </Button>
                <Button fx:id="invoicesDashboardButton" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-button">
                  <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                      <Label text="Invoices" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="invoicesLabel" text="0" style="-fx-font-weight: bold;" />
                    </HBox>
                  </graphic>
                </Button>
              </VBox>
            </TitledPane>
          </panes>
        </Accordion>

        <StackPane fx:id="contentStackPane">
          <Label styleClass="placeholder-text" text="Select a category from the left to view data." />
        </StackPane>
      </SplitPane>
    </center>

    <bottom>
      <HBox styleClass="status-bar" alignment="CENTER_LEFT" style="-fx-padding: 5px; -fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-width: 1px 0 0 0;">
        <Label fx:id="statusBarLabel" text="Status: Ready" />
      </HBox>
    </bottom>

  </BorderPane>
</VBox>
