<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane fx:id="mainGrid" prefHeight="700.0" prefWidth="600.0"
          xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.avaruusstudios.vmdb.view.vanpool.participant.ParticipantFormController"
          stylesheets="@/styles.css" styleClass="form-grid"> <columnConstraints>
    <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="150.0" minWidth="100.0" prefWidth="120.0" />
    <ColumnConstraints hgrow="SOMETIMES" maxWidth="Infinity" minWidth="200.0" prefWidth="300.0" />
</columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" /> <RowConstraints minHeight="15.0" prefHeight="80.0" vgrow="SOMETIMES" /> <RowConstraints minHeight="15.0" prefHeight="40.0" vgrow="SOMETIMES" /> <RowConstraints minHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" /> </rowConstraints>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Participant ID:" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <Label fx:id="lblParticipantID" text="[Auto-Generated]" GridPane.columnIndex="1" styleClass="form-label">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>

        <Label text="First Name:" GridPane.rowIndex="1" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <TextField fx:id="txtFirstName" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </TextField>

        <Label text="Middle Name:" GridPane.rowIndex="2" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <TextField fx:id="txtMiddleName" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </TextField>

        <Label text="Last Name:" GridPane.rowIndex="3" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <TextField fx:id="txtLastName" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </TextField>

        <Label text="Email:" GridPane.rowIndex="4" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </TextField>

        <Label text="Phone:" GridPane.rowIndex="5" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <TextField fx:id="txtPhone" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </TextField>

        <Label text="Pickup Location:" GridPane.rowIndex="6" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <ComboBox fx:id="cmbPickUpLocation" prefWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </ComboBox>

        <Label text="Drop-Off Location:" GridPane.rowIndex="7" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <ComboBox fx:id="cmbDropOffLocation" prefWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="7" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </ComboBox>

        <Label text="Distance (Miles):" GridPane.rowIndex="8" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <TextField fx:id="txtDistanceMiles" GridPane.columnIndex="1" GridPane.rowIndex="8" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </TextField>

        <Label text="Join Date:" GridPane.rowIndex="9" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <DatePicker fx:id="dpJoinDate" prefWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="9" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </DatePicker>

        <Label text="Program:" GridPane.rowIndex="10" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <ComboBox fx:id="cmbProgram" prefWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="10" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </ComboBox>

        <Label text="Benefit Amount:" GridPane.rowIndex="11" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <TextField fx:id="txtBenefitAmount" GridPane.columnIndex="1" GridPane.rowIndex="11" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </TextField>

        <Label text="Is Active:" GridPane.rowIndex="12" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <CheckBox fx:id="chkIsActive" mnemonicParsing="false" GridPane.columnIndex="1" GridPane.rowIndex="12" styleClass="form-check">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </CheckBox>

        <Label text="Role:" GridPane.rowIndex="13" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <ComboBox fx:id="cmbRole" prefWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="13" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </ComboBox>

        <Label text="Notes:" GridPane.rowIndex="14" styleClass="form-label">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </Label>
        <TextArea fx:id="txtNotes" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="14" styleClass="form-control">
            <GridPane.margin><Insets bottom="5.0" top="5.0" /></GridPane.margin>
        </TextArea>

        <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnSpan="2" GridPane.rowIndex="15">
            <GridPane.margin>
                <Insets top="10.0" />
            </GridPane.margin>
            <Button fx:id="btnSave" mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" text="Save" styleClass="btn,btn-primary" />
            <Button fx:id="btnClear" mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" text="Clear" styleClass="btn,btn-secondary" />
        </HBox>

        <HBox alignment="CENTER_LEFT" styleClass="status-bar" GridPane.columnSpan="2" GridPane.rowIndex="16">
            <Label fx:id="statusBarLabel" text="Ready" />
        </HBox>
    </children>
</GridPane>