<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.avaruusstudios.vmdb.view.vanpool.participant.DashboardParticipantController" styleClass="content-view">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <spacing>15</spacing>

    <VBox spacing="5" styleClass="content-header">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Participants" styleClass="view-title">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Refresh" onAction="#refreshData" styleClass="refresh-button"/>
        </HBox>
        <Separator styleClass="header-separator"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button text="Add Participant" fx:id="addParticipantButton" styleClass="btn-primary" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Active Participants:" styleClass="summary-label-key"/>
            <Label fx:id="lblActiveParticipants" text="N/A" styleClass="summary-label-value"/>
        </HBox>
    </VBox>

    <TableView fx:id="participantTableView" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <placeholder>
            <Label text="No Participants data available." />
        </placeholder>
    </TableView>
</VBox>